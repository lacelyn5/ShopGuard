{
  "info": {
    "name": "ShopGuard - Toolshop API Regression",
    "_postman_id": "a5c9e6b2-6c39-4c24-a0b9-5e429bba4470",
    "description": "Run Catalog first, Authentication second. This suite does not create products or orders. Uses the public official Toolshop demo account only.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Catalog",
      "description": "GET catalog checks.",
      "item": [
        {
          "name": "01 - List products",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{apiUrl}}/products",
              "host": [
                "{{apiUrl}}"
              ],
              "path": [
                "products"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"JSON response\", function () { pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"json\"); });",
                  "const data = pm.response.json();",
                  "pm.test(\"Pagination schema\", () => { pm.expect(data.data).to.be.an(\"array\").that.is.not.empty; pm.expect(data.total).to.be.a(\"number\"); });",
                  "if (data.data.length > 0) { pm.collectionVariables.set(\"productId\", data.data[0].id); pm.collectionVariables.set(\"productName\", data.data[0].name); }"
                ]
              }
            }
          ]
        },
        {
          "name": "02 - Page 1",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{apiUrl}}/products?page=1",
              "host": [
                "{{apiUrl}}"
              ],
              "path": [
                "products"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"JSON response\", function () { pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"json\"); });",
                  "pm.test(\"Page is 1\", () => pm.expect(pm.response.json().current_page).to.eql(1));"
                ]
              }
            }
          ]
        },
        {
          "name": "03 - Sort price ascending",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{apiUrl}}/products?sort=price,asc",
              "host": [
                "{{apiUrl}}"
              ],
              "path": [
                "products"
              ],
              "query": [
                {
                  "key": "sort",
                  "value": "price,asc"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"JSON response\", function () { pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"json\"); });",
                  "const prices=pm.response.json().data.map(p=>p.price); pm.test(\"Ascending prices\",()=>{for(let i=1;i<prices.length;i++) pm.expect(prices[i]).to.be.at.least(prices[i-1]);});"
                ]
              }
            }
          ]
        },
        {
          "name": "04 - Sort price descending",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{apiUrl}}/products?sort=price,desc",
              "host": [
                "{{apiUrl}}"
              ],
              "path": [
                "products"
              ],
              "query": [
                {
                  "key": "sort",
                  "value": "price,desc"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"JSON response\", function () { pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"json\"); });",
                  "const prices=pm.response.json().data.map(p=>p.price); pm.test(\"Descending prices\",()=>{for(let i=1;i<prices.length;i++) pm.expect(prices[i]).to.be.at.most(prices[i-1]);});"
                ]
              }
            }
          ]
        },
        {
          "name": "05 - Get known product",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{apiUrl}}/products/{{productId}}",
              "host": [
                "{{apiUrl}}"
              ],
              "path": [
                "products",
                "{{productId}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"JSON response\", function () { pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"json\"); });",
                  "pm.test(\"Correct item fetched\",()=>pm.expect(pm.response.json().id).to.eql(pm.collectionVariables.get(\"productId\")));"
                ]
              }
            }
          ]
        },
        {
          "name": "06 - Search known name",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{apiUrl}}/products/search?q={{productName}}",
              "host": [
                "{{apiUrl}}"
              ],
              "path": [
                "products",
                "search"
              ],
              "query": [
                {
                  "key": "q",
                  "value": "{{productName}}"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"JSON response\", function () { pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"json\"); });",
                  "pm.test(\"Search includes known product\",()=>{const ids=pm.response.json().data.map(p=>p.id);pm.expect(ids).to.include(pm.collectionVariables.get(\"productId\"));});"
                ]
              }
            }
          ]
        },
