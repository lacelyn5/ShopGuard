    },
    {
      "name": "Authentication",
      "description": "Read-only endpoint checks; the only POST is demo login.",
      "item": [
        {
          "name": "11 - Anonymous profile denied",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{apiUrl}}/users/me",
              "host": [
                "{{apiUrl}}"
              ],
              "path": [
                "users",
                "me"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"401 without token\", () => pm.response.to.have.status(401));"
                ]
              }
            }
          ]
        },
        {
          "name": "12 - Anonymous admin report denied",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{apiUrl}}/reports/top10-purchased-products",
              "host": [
                "{{apiUrl}}"
              ],
              "path": [
                "reports",
                "top10-purchased-products"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"401 without admin\", () => pm.response.to.have.status(401));"
                ]
              }
            }
          ]
        },
        {
          "name": "13 - Demo customer sign-in",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{apiUrl}}/users/login",
              "host": [
                "{{apiUrl}}"
              ],
              "path": [
                "users",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{demoEmail}}\",\n  \"password\": \"{{demoPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"JSON response\", function () { pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"json\"); });",
                  "const data=pm.response.json(); pm.test(\"Bearer token returned\",()=>pm.expect(data.access_token).to.be.a(\"string\").that.is.not.empty); pm.collectionVariables.set(\"accessToken\",data.access_token);"
                ]
              }
            }
          ]
        },
        {
          "name": "14 - Read signed-in profile",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{apiUrl}}/users/me",
              "host": [
                "{{apiUrl}}"
              ],
              "path": [
                "users",
                "me"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"JSON response\", function () { pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"json\"); });",
                  "pm.test(\"Public demo customer matches\",()=>pm.expect(pm.response.json().email.toLowerCase()).to.eql(pm.environment.get(\"demoEmail\").toLowerCase()));"
                ]
              }
            }
          ]
        }
      ]
    }
